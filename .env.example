# ─── Prism — Environment Variables ───
# Copy this to .env.local and fill in real values.
# NEVER commit .env.local to git.

# ─── Frontend (apps/web) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_INSFORGE_URL=https://your-project-ref.insforge.app
NEXT_PUBLIC_INSFORGE_ANON_KEY=your-anon-key-here

# ─── Backend (apps/api) ───
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.insforge.app:5432/postgres
ADMIN_DATABASE_URL=postgresql://postgres:your-password@db.your-admin-ref.insforge.app:5432/postgres
INSFORGE_URL=https://your-project-ref.insforge.app
INSFORGE_SERVICE_KEY=your-service-key-here
INSFORGE_JWT_SECRET=your-jwt-secret-here
REDIS_URL=rediss://default:your-password@your-endpoint:6379
AI_BASE_URL=https://openrouter.ai/api/v1
AI_API_KEY=your-ai-api-key-here
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SECRET_KEY=generate-a-random-32-character-string
ADMIN_SECRET_KEY=generate-a-different-32-char-string
CRON_SECRET=super-secret-cron-key
ALLOWED_ORIGINS=http://localhost:3000
